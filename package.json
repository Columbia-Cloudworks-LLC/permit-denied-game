{
  "name": "permit-denied",
  "private": true,
  "version": "1.0.25",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:mobile": "node scripts/verify-mobile.mjs",
    "test:pwa": "node scripts/verify-pwa.mjs",
    "test:debug": "node scripts/verify-debug-binder.mjs",
    "test:privacy": "node scripts/verify-privacy.mjs",
    "capture:assets": "node scripts/capture-assets.mjs",
    "catalog:local": "npm run build && node scripts/catalog.mjs local",
    "catalog:generate": "node scripts/catalog.mjs generate",
    "test:catalog": "node --test scripts/catalog.test.mjs && node scripts/verify-catalog.mjs",
    "screenshot:title": "node scripts/capture-title.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "pixi.js": "^8.16.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "playwright": "1.63.0",
    "sharp": "^0.35.4",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.131.1"
  }
}
