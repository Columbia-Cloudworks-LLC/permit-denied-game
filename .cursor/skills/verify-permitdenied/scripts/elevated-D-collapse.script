assert scene=play
hold w 90
tap space
assert blade=down
hold w 40
# Sweep along south facade
hold d 8
hold w 80
shot D1_bitten.png
dump D1_bitten.json
hold w 100
shot D2_collapsing.png
dump D2_collapsing.json
hold w 150
shot D3_rubble.png
dump D3_rubble.json
assert rubble>0
assert struct_cash>0
tap r
assert scene=play
assert struct_cash=0
assert rubble=0
shot E_restarted.png
dump E_restarted.json
