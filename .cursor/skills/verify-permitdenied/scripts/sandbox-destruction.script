# Hall south-face bite on the normal sandbox lot (elevated 2-story).
assert scene=play
assert title=PERMIT DENIED
shot intact.png
dump start.json

hold w 90
tap space
assert blade=down
hold w 40
hold d 8
hold w 100
shot bitten.png
dump bitten.json
assert struct_cash>0
assert rubble>0

hold w 100
shot collapsing.png
dump collapsing.json

hold w 150
shot destroyed.png
dump destroyed.json
assert rubble>0

tap r
assert scene=play
assert struct_cash=0
assert rubble=0
shot restarted.png
dump restarted.json
