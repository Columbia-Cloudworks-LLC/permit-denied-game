# Controlled shed bite with camera still on the structure.
assert scene=play
assert title=PERMIT DENIED
shot intact.png
dump start.json

# Face the shed, blade down, chew in place.
hold a 28
tap space
assert blade=down
# Approach shed from south-east of door
hold w,a 50
hold w 80
shot bitten.png
dump bitten.json
assert struct_cash>0
assert rubble>0

# Keep blade in contact for dust / more local breaks without fleeing
hold w 60
shot collapsing.png
dump collapsing.json

hold w 90
shot destroyed.png
dump destroyed.json
assert rubble>0

tap r
assert scene=play
assert struct_cash=0
assert rubble=0
shot restarted.png
dump restarted.json
